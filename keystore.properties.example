# 本地打签名 release 包用的配置模板。
#
# 用法：复制为项目根目录的 keystore.properties 并填上真实值。
# keystore.properties 已在 .gitignore 中排除，不会进版本库——但填完仍请确认一次。
#
# CI（GitHub Actions）不用这个文件，而是读同名内容的环境变量：
#   SIGNING_STORE_FILE / SIGNING_STORE_PASSWORD / SIGNING_KEY_ALIAS / SIGNING_KEY_PASSWORD
#
# storeFile 相对项目根目录。
storeFile=keystore/manote-release.jks
storePassword=
keyAlias=manote
keyPassword=
